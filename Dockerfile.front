FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build React app / assets
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy built assets to nginx www root
COPY --from=builder /app/public /var/www/public

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
